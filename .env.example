# ────────────────────────────────────────────────────────────────
# Controle Casa de Aluguel — variáveis de ambiente
# ────────────────────────────────────────────────────────────────

# Porta interna que o Express vai escutar (Caddy fará o proxy externo).
PORT=3002

# Senha para acessar o site. NUNCA deixe em branco em produção.
# A primeira vez que o app subir, ele cria o hash bcrypt automaticamente.
APP_PASSWORD=troque-essa-senha-agora

# Segredo da sessão (cookie). Use uma string longa e aleatória.
# Gere com:  openssl rand -hex 32
SESSION_SECRET=troque-este-segredo-com-openssl-rand-hex-32

# Defina como "true" se o site for servido via HTTPS (Caddy faz isso).
# Em desenvolvimento local sem HTTPS, deixe "false".
COOKIE_SECURE=true

# Timezone (não muda pra rodar no Brasil — já é o default no docker-compose).
TZ=America/Sao_Paulo
